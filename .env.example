NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000
# Only needed if the admin panel is split onto its own host/subdomain -
# unset means admin login always falls back to WEB_APP_URL. Local dev:
# admin.localhost:3000 (see docs/DEPLOYMENT.md for the /etc/hosts note).
ADMIN_WEB_APP_URL=http://admin.localhost:3000
API_BASE_URL=http://localhost:4000
# Every legitimate frontend origin that calls this API with credentials -
# comma-separated, no wildcard. Both portals are required once the admin
# subdomain is live, since it's a separate origin from the main site.
CORS_ORIGIN=http://localhost:3000,http://admin.localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_harvesting
# All optional - shown here at their built-in defaults. See docs/DATABASE.md
# for the max-connections calculation before raising DB_POOL_MAX.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_QUERY_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
# Portal session lifetimes - all optional, shown here at their built-in
# defaults. Admin sessions are deliberately much shorter-lived than user
# sessions; keep it that way if you override these.
# USER_ACCESS_TOKEN_TTL_SECONDS=900
# USER_REFRESH_TOKEN_TTL_DAYS=30
# ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
# ADMIN_REFRESH_TOKEN_TTL_HOURS=4
ENCRYPTION_MASTER_KEY=replace-with-at-least-32-characters
ENCRYPTION_KEY_VERSION=v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_PROVIDER=eodhd
EODHD_API_TOKEN=
# Optional ISO date; when past, admin status shows expired without probing vendor API.
EODHD_EXPIRES_AT=
EODHD_EXCHANGE_CODE=US
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:3000/admin/data-provider/callback
GLOBAL_DATAFEEDS_ENABLED=false
GLOBAL_DATAFEEDS_API_KEY=
# Optional ISO date; set this to the vendor expiry date to prevent stale connected status.
GLOBAL_DATAFEEDS_EXPIRES_AT=
GLOBAL_DATAFEEDS_WS_URL=wss://test.lisuns.com:4576
GLOBAL_DATAFEEDS_EXCHANGES=BSE,BSE_IDX
GLOBAL_DATAFEEDS_SYMBOL_LIMIT=100
GLOBAL_DATAFEEDS_FUNDAMENTALS_ENABLED=false
GLOBAL_DATAFEEDS_FUNDAMENTALS_ACCESS_KEY=
GLOBAL_DATAFEEDS_FUNDAMENTALS_BASE_URL=https://test.lisuns.com:4532
GLOBAL_DATAFEEDS_FUNDAMENTALS_EXCHANGE=BSE
GEMINI_API_KEY=
# Optional - override the default model per task type (admin can also set
# a per-deployment key/model via the AI settings UI).
# GEMINI_EXTRACTION_MODEL=
# GEMINI_CHAT_MODEL=
# Web Push (price alert notifications) - optional; alerts simply can't
# send push notifications until these are set. Generate a VAPID key pair
# with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@stockharvesting.com
