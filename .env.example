NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_harvesting
# All optional - shown here at their built-in defaults. See docs/DATABASE.md
# for the max-connections calculation before raising DB_POOL_MAX.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_QUERY_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
ENCRYPTION_MASTER_KEY=replace-with-at-least-32-characters
ENCRYPTION_KEY_VERSION=v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_PROVIDER=eodhd
EODHD_API_TOKEN=
# Optional ISO date; when past, admin status shows expired without probing vendor API.
EODHD_EXPIRES_AT=
EODHD_EXCHANGE_CODE=US
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:3000/admin/data-provider/callback
GLOBAL_DATAFEEDS_ENABLED=false
GLOBAL_DATAFEEDS_API_KEY=
# Optional ISO date; set this to the vendor expiry date to prevent stale connected status.
GLOBAL_DATAFEEDS_EXPIRES_AT=
GLOBAL_DATAFEEDS_WS_URL=wss://test.lisuns.com:4576
GLOBAL_DATAFEEDS_EXCHANGES=BSE,BSE_IDX
GLOBAL_DATAFEEDS_SYMBOL_LIMIT=100
GLOBAL_DATAFEEDS_FUNDAMENTALS_ENABLED=false
GLOBAL_DATAFEEDS_FUNDAMENTALS_ACCESS_KEY=
GLOBAL_DATAFEEDS_FUNDAMENTALS_BASE_URL=https://test.lisuns.com:4532
GLOBAL_DATAFEEDS_FUNDAMENTALS_EXCHANGE=BSE
GEMINI_API_KEY=
